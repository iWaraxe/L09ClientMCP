    "info": {
        "name": "L09ClientMCP - Branch 5: SSE Transport Integration",
        "description": "Educational API collection for demonstrating MCP SSE Transport functionality with real external servers.\\n\\n**Prerequisites:**\\n- Node.js MCP server running on localhost:3000\\n- Application running on localhost:8080 with mcp-sse profile\\n- OPENAI_API_KEY environment variable set\\n\\n**Branch 5 Features:**\\n- Real MCP protocol communication over SSE\\n- External server integration and tool invocation\\n- Network-based error handling and retry logic\\n- Performance and latency testing\\n- Production-ready transport patterns\\n\\n**Setup Instructions:**\\n1. Start MCP server: `cd mcp-server && npm start`\\n2. Start Spring AI app: `./mvnw spring-boot:run -Dspring.profiles.active=mcp-sse`\\n3. Run this collection to test SSE integration\\n\\n**Learning Objectives:**\\n- Experience real MCP protocol over network\\n- Understand SSE transport benefits and challenges\\n- See network latency and error handling in action\\n- Compare mock vs. real server behavior",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Health Check - SSE Transport Status",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Health check returns 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Response indicates SSE transport', function () {",
                            "    const responseText = pm.response.text();",
                            "    pm.expect(responseText).to.include('Type: SSE');",
                            "});",
                            "",
                            "pm.test('External server connection status', function () {",
                            "    const responseText = pm.response.text();",
                            "    const connectionMatch = responseText.match(/Status: (\\\\w+)/);",
                            "    ",
                            "    if (connectionMatch) {",
                            "        const status = connectionMatch[1];",
                            "        console.log('🔗 MCP SSE Connection Status: ' + status);",
                            "        ",
                            "        if (status === 'connected') {",
                            "            console.log('✅ External MCP server is connected via SSE');",
                            "            console.log('🛠️  Ready for real tool integration testing');",
                            "        } else {",
                            "            console.log('❌ External MCP server not connected');",
                            "            console.log('💡 Start server: cd mcp-server && npm start');",
                            "        }",
                            "    }",
                            "});",
                            "",
                            "pm.test('Tool count from external server', function () {",
                            "    const responseText = pm.response.text();",
                            "    const toolMatch = responseText.match(/(\\\\d+) tools/);",
                            "    ",
                            "    if (toolMatch) {",
                            "        const toolCount = parseInt(toolMatch[1]);",
                            "        console.log('🛠️  Available tools from external server: ' + toolCount);",
                            "        ",
                            "        if (toolCount >= 2) {",
                            "            console.log('✅ Expected tools available (echo, ping)');",
                            "        } else {",
                            "            console.log('⚠️  Fewer tools than expected - check server');",
                            "        }",
                            "    }",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
