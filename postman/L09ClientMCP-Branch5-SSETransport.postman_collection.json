        {
            "name": "Chat - Fallback When Server Unavailable",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Fallback request successful', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Graceful degradation behavior', function () {",
                            "    const jsonData = pm.response.json();",
                            "    const response = jsonData.response.toLowerCase();",
                            "    ",
                            "    // Should either use tool (if server available) or fall back to AI",
                            "    const isToolResponse = response.includes('echo tool');",
                            "    const isAIFallback = response.includes('echo') && !response.includes('echo tool');",
                            "    ",
                            "    pm.expect(isToolResponse || isAIFallback).to.be.true;",
                            "});",
                            "",
                            "// Analyze response type",
                            "const jsonData = pm.response.json();",
                            "const response = jsonData.response;",
                            "",
                            "if (response.toLowerCase().includes('echo tool')) {",
                            "    console.log('🔗 External server available - tool invocation successful');",
                            "    console.log('✅ SSE transport working correctly');",
                            "} else {",
                            "    console.log('🔄 External server unavailable - graceful degradation to AI');",
                            "    console.log('💡 This demonstrates production resilience patterns');",
                            "}",
                            "",
                            "console.log('🎯 Fallback Response:');",
                            "console.log(response);",
                            "console.log('');",
                            "console.log('📚 Educational Points:');",
                            "console.log('- Graceful degradation in distributed systems');",
                            "console.log('- External dependency failure handling');",
                            "console.log('- User experience preservation during outages');",
                            "console.log('- Production reliability patterns');"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
