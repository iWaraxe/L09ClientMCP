        {
            "name": "Circuit Breaker Tests",
            "description": "Tests for circuit breaker behavior and fault tolerance",
            "item": [
                {
                    "name": "Circuit Breaker Status",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Contains circuit breaker information\", function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response).to.be.an('object');",
                                    "    // Should contain server circuit breaker states",
                                    "    Object.values(response).forEach(serverState => {",
                                    "        pm.expect(serverState).to.have.property('state');",
                                    "        pm.expect(serverState).to.have.property('failureCount');",
                                    "        pm.expect(['CLOSED', 'OPEN', 'HALF_OPEN']).to.include(serverState.state);",
                                    "    });",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/mcp/multi-server/circuit-breaker/status",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "mcp", "multi-server", "circuit-breaker", "status"]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Force Circuit Breaker Test",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// This test might fail if circuit breaker opens",
                                    "pm.test(\"Request completes\", function () {",
                                    "    pm.expect([200, 500, 503]).to.include(pm.response.code);",
                                    "});",
                                    "",
                                    "if (pm.response.code === 500 || pm.response.code === 503) {",
                                    "    pm.test(\"Circuit breaker related error\", function () {",
                                    "        const response = pm.response.json();",
                                    "        pm.expect(response.message || response.error).to.match(/circuit.*breaker|timeout|failed/i);",
                                    "    });",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
