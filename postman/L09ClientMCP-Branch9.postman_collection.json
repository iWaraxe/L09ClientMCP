        {
            "name": "Load Balancing Tests",
            "description": "Tests to verify load balancing behavior across multiple servers",
            "item": [
                {
                    "name": "Echo Tool - Load Balancing Test 1",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Response contains server information\", function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response).to.have.property('content');",
                                    "    pm.expect(response).to.have.property('serverId');",
                                    "});",
                                    "",
                                    "// Store server ID for load balancing verification",
                                    "const response = pm.response.json();",
                                    "pm.globals.set('server1_id', response.serverId);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"toolName\": \"echo\",\n  \"arguments\": {\n    \"message\": \"Load balancing test 1\",\n    \"format\": \"uppercase\"\n  }\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/mcp/multi-server/invoke",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "mcp", "multi-server", "invoke"]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Echo Tool - Load Balancing Test 2",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "// Store server ID for comparison",
                                    "const response = pm.response.json();",
                                    "pm.globals.set('server2_id', response.serverId);",
                                    "",
                                    "// With round-robin, we might get a different server",
                                    "// (depending on how many servers are available)",
                                    "pm.test(\"Load balancing is working\", function () {",
                                    "    const server1 = pm.globals.get('server1_id');",
                                    "    const server2 = pm.globals.get('server2_id');",
                                    "    // If we have multiple servers, they should alternate",
                                    "    // If only one server, they'll be the same",
                                    "    pm.expect([server1, server2]).to.include(response.serverId);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"toolName\": \"echo\",\n  \"arguments\": {\n    \"message\": \"Load balancing test 2\",\n    \"format\": \"lowercase\"\n  }\n}"
                        },
