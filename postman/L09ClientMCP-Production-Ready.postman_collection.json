				"exec": [
					"// Set up large text for testing",
					"const largeText = \"This is a test of how the system handles larger input text. \".repeat(100);",
					"pm.globals.set(\"large_text\", largeText);",
					"",
					"// Log request start time for performance tracking",
					"pm.globals.set(\"request_start_time\", new Date().getTime());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test for all requests",
					"pm.test(\"Response has proper headers\", function () {",
					"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.exist;",
					"});",
					"",
					"// Track request timing",
					"const startTime = pm.globals.get(\"request_start_time\");",
					"const endTime = new Date().getTime();",
					"const duration = endTime - startTime;",
					"",
					"console.log(`Request completed in ${duration}ms`);",
					"",
					"// Log any error responses for debugging",
					"if (pm.response.code >= 400) {",
					"    console.log(`Error Response [${pm.response.code}]: ${pm.response.text()}`);",
					"}"
				]
			}
		}
