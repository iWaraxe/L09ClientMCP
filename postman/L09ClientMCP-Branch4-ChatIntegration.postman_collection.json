                            "pm.test('Response handles tool error gracefully', function () {",
                            "    const jsonData = pm.response.json();",
                            "    const response = jsonData.response.toLowerCase();",
                            "    // Should mention tool usage and error",
                            "    const hasErrorHandling = response.includes('error') || ",
                            "                            response.includes('tried') ||",
                            "                            response.includes('attempted') ||",
                            "                            response.includes('echo tool');",
                            "    pm.expect(hasErrorHandling).to.be.true;",
                            "});",
                            "",
