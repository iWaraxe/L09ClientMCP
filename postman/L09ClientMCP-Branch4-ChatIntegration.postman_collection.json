        {
            "name": "Chat - Standard AI Response (No Tools)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Standard chat successful', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Response is conversational AI', function () {",
                            "    const jsonData = pm.response.json();",
                            "    const response = jsonData.response.toLowerCase();",
                            "    // Should NOT mention tools for this question",
                            "    pm.expect(response).to.not.include('echo tool');",
                            "    pm.expect(response).to.not.include('ping tool');",
                            "});",
                            "",
                            "pm.test('Response discusses weather appropriately', function () {",
                            "    const jsonData = pm.response.json();",
                            "    const response = jsonData.response.toLowerCase();",
                            "    // Should mention weather or acknowledge the question",
                            "    const hasWeatherResponse = response.includes('weather') || ",
                            "                               response.includes('temperature') ||",
                            "                               response.includes('forecast') ||",
                            "                               response.includes('climate');",
                            "    pm.expect(hasWeatherResponse).to.be.true;",
                            "});",
                            "",
                            "console.log('🌤️ Standard AI Response:');",
                            "console.log(pm.response.json().response);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
