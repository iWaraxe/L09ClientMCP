        },
        {
          "name": "External MCP Server Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Branch 7: NEW - Validate external MCP server connectivity",
                  "pm.test(\"External MCP server is running\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Server returns health information\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('status');",
                  "    pm.expect(responseJson).to.have.property('uptime');",
                  "});",
                  "",
                  "pm.test(\"MCP server is healthy\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.status).to.eql('healthy');",
                  "});",
                  "",
                  "// Educational logging",
                  "const health = pm.response.json();",
                  "console.log(\"🌐 External MCP Server Health:\");", 
                  "console.log(\"  Status:\", health.status);",
                  "console.log(\"  Uptime:\", health.uptime);",
                  "console.log(\"  Server Type:\", health.server || 'MCP Echo Server');",
                  "",
                  "console.log(\"✅ Branch 7: External server connectivity confirmed\");",
                  "console.log(\"📊 Next: Test tool discovery via SSE transport\");"
                ]
              }
            }
          ],
